# Copy to .env.local. Everything is optional for local development: each
# service falls back to a local stand-in. Production refuses to boot until the
# items marked [prod] are set (see src/server/env.ts), and `next build` refuses
# to build without the [prod] NEXT_PUBLIC_ ones (see next.config.ts).

# Set to 1 to run `npm run build` without the NEXT_PUBLIC_ values, as a local
# check. That build refuses to start in production.
ALLOW_DEV_BUILD=

# [prod] The public https:// address, not localhost. Video callbacks, Veriff's
# return link and the Solana Pay icon are built from it.
APP_URL=http://localhost:3000

# ── Database ───────────────────────────────────────────────────────────────
# [prod] Postgres with pgvector. Supabase: Project Settings > Database >
# Connection string (transaction pooler, port 6543). Then: npm run db:migrate
# Unset locally = embedded PGlite in .data/pglite (migrates and seeds itself).
DATABASE_URL=
# 1 = migrate and seed on first connection instead of the db:migrate deploy step
# (for hosts without one). Migrations take no lock: avoid it when several
# instances can boot at once.
AUTO_MIGRATE=

# ── Accounts ───────────────────────────────────────────────────────────────
# Login is a username and password on our own server (scrypt hashes, session
# cookie). No email, social or wallet login. Works locally with nothing set.
# [prod] Comma-separated user ids (UUIDs) that get the admin console. Sign up
# first, then copy your id from /profile or the users table. At least one: only
# admins action reports and lift age locks and explicit holds.
ADMIN_USER_IDS=
# Set to 0 to disable the x-dev-user header and dev handles even in development.
ALLOW_DEV_AUTH=

# ── Wallets (Privy) ────────────────────────────────────────────────────────
# Every account gets an embedded Solana wallet from Privy, through Privy's
# JWT-based (custom) auth: our server signs a short-lived token for the signed-in
# user and publishes its public key at {APP_URL}/api/auth/jwks. Setup steps:
# docs/SETUP.md ("Wallets"). Unset locally = no wallet; everything else works.
# Privy can't reach a localhost JWKS, so wallets only appear on a public URL
# (a deployment, or a tunnel to your machine).
# [prod] dashboard.privy.io > your app > App ID. Turn off every Privy login
# method, and turn on "App pays" gas sponsorship for Solana so USDC payers need
# no SOL. NEXT_PUBLIC_ values are baked into the browser at build time: set them
# for the build as well as at runtime, and rebuild after changing them.
NEXT_PUBLIC_PRIVY_APP_ID=
# [prod] ES256 (P-256) private key, PKCS#8 PEM, that signs the wallet tokens:
#   openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt
# On one line, write the line breaks as \n. Keep it secret.
AUTH_JWT_PRIVATE_KEY=

# ── Chat model (any OpenAI-compatible API) ─────────────────────────────────
# [prod] DeepInfra: https://api.deepinfra.com/v1/openai   Featherless: https://api.featherless.ai/v1
# OpenRouter: https://openrouter.ai/api/v1 (pin providers with LLM_EXTRA_BODY).
# Get written confirmation that the provider allows adult fiction before launch.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-ai/DeepSeek-V3.1
# Optional smarter tier for members, and a cheap model for memory/summaries.
LLM_PREMIUM_MODEL=
LLM_UTILITY_MODEL=
# e.g. {"provider":{"only":["deepinfra"],"allow_fallbacks":false,"data_collection":"deny"}}
LLM_EXTRA_BODY=

# Embeddings for long-term memory. Must return 1024 dimensions (bge-m3 does).
# Defaults to the LLM endpoint and key.
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=BAAI/bge-m3

# ── Text moderation (second layer; the blocklist always runs) ─────────────
# [prod] gpt-oss-safeguard-20b on any OpenAI-compatible host. It applies our own
# policy (src/server/safety/moderation.ts). Not Llama Guard: its fixed taxonomy
# flags all sexual content, and the app can't read its answers.
MODERATION_BASE_URL=
MODERATION_API_KEY=
MODERATION_MODEL=openai/gpt-oss-safeguard-20b
# Merged into each request (JSON). Low reasoning effort keeps checks fast, but
# hosts name it differently: {"reasoning_effort":"low"} (vLLM, Groq) or
# {"reasoning":{"effort":"low"}} (OpenRouter). A host that rejects a field
# answers 400, and every photo, video, character and memory check fails
# (classifier_error in /admin). Test it first: docs/SETUP.md.
MODERATION_EXTRA_BODY={"reasoning_effort":"low"}
# Extra real names to refuse (comma separated).
BLOCKED_NAMES=

# ── Images and video (self-hosted GPU worker, see workers/media) ──────────
# [prod] IMAGE_PROVIDER=worker, IMAGE_API_URL pointing at the worker on an
# adult-tolerant GPU host, and IMAGE_API_KEY. fal, RunPod, Modal and Together
# ban explicit content.
# Locally: mock (placeholder art) or pollinations (public API, dev only).
IMAGE_PROVIDER=mock
IMAGE_API_URL=
# The worker answers whoever holds this key, without the app's Hive checks: keep
# it secret and firewall the worker to the app's egress IPs.
IMAGE_API_KEY=
# Wan 2.2 video worker; defaults to the image worker.
VIDEO_API_URL=
VIDEO_API_KEY=
# [prod] Hive (thehive.ai): three projects, one key each.
# Visual moderation (sexual/minor/gore classes):
HIVE_API_KEY=
# Demographics (apparent age of each face):
HIVE_DEMOGRAPHIC_API_KEY=
# Celebrity recognition (real, identifiable people):
HIVE_CELEBRITY_API_KEY=
# Optional override of the sync endpoint.
HIVE_API_URL=
# Set to 0 to require moderation even in development.
ALLOW_UNMODERATED_IMAGES=

# ── Voice notes (OpenAI-compatible /audio/speech, e.g. Kokoro-FastAPI) ────
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=kokoro

# ── Media storage (S3-compatible: Cloudflare R2 or AWS S3) ────────────────
# [prod] R2: dash.cloudflare.com > R2 > bucket > API token, with
# S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com and S3_REGION=auto.
# AWS S3: leave S3_ENDPOINT empty and set the bucket's region ("auto" is R2 only).
# Unset locally = files in .data/media.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Payments (Solana, USDC first) ──────────────────────────────────────────
# [prod] Exactly "devnet" (testing) or "mainnet" (real money); anything else
# stops the boot. Production must set it explicitly, and both must match.
SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# [prod] Paid RPC (Helius). Server-side; never expose this one to the browser.
# At boot its genesis hash must match SOLANA_CLUSTER.
SOLANA_RPC_URL=
# [prod] Browser RPC (a domain-restricted Helius key is fine: the boot check
# sends Origin: APP_URL). Its genesis hash must match SOLANA_CLUSTER too.
NEXT_PUBLIC_SOLANA_RPC_URL=
# [prod] Wallet that receives payments. Use a multisig (Squads) on mainnet.
TREASURY_ADDRESS=
# [prod] Helius > Webhooks > your webhook > Authorization header value.
HELIUS_WEBHOOK_SECRET=
# [prod] Shared secret for the reconcile cron (Authorization: Bearer ...), which
# must run every minute: vercel.json schedules it on Vercel (paid plan).
CRON_SECRET=
# [prod] Chainalysis sanctions screening API key (free; request at chainalysis.com).
CHAINALYSIS_API_KEY=
# Extra wallet addresses to refuse (comma separated).
SANCTIONS_BLOCKLIST=
# Price feeds for SOL checkout. Pyth Hermes needs a key since Aug 2026; without
# it SOL checkout is off on mainnet and USDC still works.
PYTH_API_KEY=
JUPITER_API_KEY=
# Support contact shown on the pricing and refund pages.
NEXT_PUBLIC_SUPPORT_EMAIL=

# ── Age model ──────────────────────────────────────────────────────────────
# gate (default): visitors give a date of birth before any page, and again at
# sign-up, where the server re-checks it; every signed-up adult gets explicit
# content. No ID check; only the time of confirmation is stored, never the date.
# id: explicit content also needs a passed Veriff ID check.
AGE_VERIFICATION=gate

# ── Age verification (Veriff, optional) ────────────────────────────────────
# [prod with AGE_VERIFICATION=id] veriff.com > Integrations > API keys. Set the
# webhook URL to {APP_URL}/api/webhooks/veriff.
VERIFF_API_KEY=
VERIFF_SHARED_SECRET=
VERIFF_BASE_URL=https://stationapi.veriff.com
# Set to 0 to hide the "simulate verification" button in development.
ALLOW_DEV_AGE_CHECK=

# ── Region blocking ────────────────────────────────────────────────────────
# ISO country codes. Sanctioned regions by default; add any market where we
# haven't met age-verification rules (e.g. GB, FR, DE, IT, AU). See
# "Jurisdictions that require age verification" in docs/SETUP.md.
BLOCKED_COUNTRIES=CU,IR,KP,SY,RU,BY
# States and provinces, as country-region codes (e.g. US-TX,US-UT). None by default.
BLOCKED_REGIONS=
# The only headers trusted for the visitor's country, region and IP. Vercel
# sets (and overwrites) these defaults. Behind Cloudflare use cf-ipcountry,
# cf-region-code and cf-connecting-ip, and only if the origin accepts
# Cloudflare traffic alone.
GEO_COUNTRY_HEADER=x-vercel-ip-country
GEO_REGION_HEADER=x-vercel-ip-country-region
CLIENT_IP_HEADER=x-real-ip
